# Copy to STS2-Game2CLI/.env and fill in your values.

# Default provider + model used by pi-agent when you do not pass --provider/--model.
PI_PROVIDER=openrouter
PI_MODEL=auto

# Standard OpenRouter API key.
OPENROUTER_API_KEY=sk-or-...

# Optional: keep pi auth/models/session state local to this project.
PI_CODING_AGENT_DIR=/absolute/path/to/STS2-Game2CLI/.agents/pi-home

# Optional: override the provider base URL at runtime.
# If PI_BASE_URL is set, the launcher writes a models.json override into PI_CODING_AGENT_DIR.
# PI_API_KEY_ENV should be the environment variable name that pi should resolve for the provider.
#
# PI_BASE_URL=https://openrouter.ai/api/v1
# PI_API_KEY_ENV=OPENROUTER_API_KEY
